{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "Asked the first time Music mode opens, before Tonton reads or controls Spotify or Apple Music, once for each. The same English as in scripts/build-app.sh.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the music playing on this Mac in the notch, and control it from there."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez dans l’encoche la musique en cours sur ce Mac, et pilotez-la de là."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Asked before the first dictation. The same English as in scripts/build-app.sh.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictate messages to your Claude Code sessions from the notch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictez des messages à vos sessions Claude Code depuis l’encoche."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Asked before the first dictation. The same English as in scripts/build-app.sh.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn what you dictate in the notch into text for Claude."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformez ce que vous dictez dans l’encoche en texte pour Claude."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
