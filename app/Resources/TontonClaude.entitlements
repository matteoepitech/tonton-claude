<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Dictation in the composer: with the hardened runtime, the microphone needs this. -->
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- Music mode reads and drives Spotify and Apple Music through AppleScript: with the hardened runtime, Apple Events need this. -->
  <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
