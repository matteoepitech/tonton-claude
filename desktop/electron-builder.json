{
  "appId": "tech.d3l.tontonclaude.island",
  "productName": "Tonton Claude",
  "directories": {
    "output": "out"
  },
  "files": ["dist/**", "package.json"],
  "electronLanguages": ["en-US"],
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "dist/icon.png"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "shortcutName": "Tonton Claude",
    "artifactName": "TontonClaude-Setup-${version}.${ext}"
  },
  "linux": {
    "target": [{ "target": "AppImage", "arch": ["x64"] }, { "target": "deb", "arch": ["x64"] }],
    "icon": "dist/icon.png",
    "executableName": "tonton-claude",
    "category": "Development",
    "maintainer": "matteoepitech",
    "synopsis": "Your Claude Code sessions at the top of the screen",
    "artifactName": "TontonClaude-${version}-${arch}.${ext}"
  }
}
