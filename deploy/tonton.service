[Unit]
Description=Tonton Claude relay server
After=network-online.target
Wants=network-online.target

[Service]
User=tontond
Group=tontond
WorkingDirectory=/opt/tonton
EnvironmentFile=/etc/tonton/tonton.env
Environment=PORT=80 DIST_DIR=/opt/tonton/dist TONTON_DATA_DIR=/var/lib/tonton BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
# Accounts and machines (SQLite) live here; the rest of the filesystem stays read-only for the service.
StateDirectory=tonton
StateDirectoryMode=0700
ExecStart=/opt/bun/bin/bun relay/src/main.ts
Restart=always
RestartSec=2

# Sandboxing: the relay only needs to read its code and open sockets.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# Port 80 (the reverse proxy targets it) is the only privilege granted.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0077

[Install]
WantedBy=multi-user.target
