<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. Archives for TestFlight and the App Store get "production" from their profile. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Permission requests break through Focus. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- The Keychain item that holds the account, shared with the widget and the notification extension. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.tech.d3l.tontonclaude</string>
	</array>
</dict>
</plist>
