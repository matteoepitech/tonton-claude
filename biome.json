{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "agent/**",
      "relay/**",
      "shared/**",
      "web/**",
      "scripts/**",
      "test/**",
      "raycast/src/**",
      "desktop/src/**",
      "desktop/scripts/**",
      "desktop/test/**",
      "desktop/*.json",
      "*.json",
      "!**/node_modules",
      "!**/dist",
      "!**/data",
      "!shared/test/swift-vectors.json",
      "!web/test/swift-qr.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error"
      }
    },
    "domains": {
      "react": "none"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["web/site/**"],
      "linter": {
        "domains": {
          "react": "recommended"
        }
      }
    }
  ]
}
